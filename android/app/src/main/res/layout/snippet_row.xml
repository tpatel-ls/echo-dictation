<?xml version="1.0" encoding="utf-8"?>
<!-- One snippet row: cue + a one-line expansion preview, with a delete button. Tapping the row
     loads it into the edit form above. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_cue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/echo_text"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/row_expansion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/echo_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/row_delete"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="@string/snippet_delete" />
</LinearLayout>
