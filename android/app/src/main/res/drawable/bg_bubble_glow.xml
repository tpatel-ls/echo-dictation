<?xml version="1.0" encoding="utf-8"?>
<!-- Soft violet aura behind the recording pill (Wispr-style halo). A radial gradient that fades
     from a translucent violet centre to fully transparent, drawn in the root's 16dp padding ring. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="120dp"
        android:startColor="#4D7C3AED"
        android:centerColor="#1F7C3AED"
        android:endColor="#007C3AED" />
</shape>
