{
  "name": "echo",
  "version": "0.1.0",
  "description": "Push-to-talk dictation for Windows & macOS — hold a key to dictate via a self-hosted Whisper node.",
  "author": "Tanay",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:native && electron-vite build",
    "preview": "electron-vite preview",
    "install:mac:all-users": "node scripts/install-mac-all-users.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "ensure:mac-signing": "node scripts/ensure-local-codesign-identity.mjs",
    "pack:mac": "npm run ensure:mac-signing && npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run ensure:mac-signing && npm run build && electron-builder --mac",
    "sync-server": "tsx src/server/index.ts"
  },
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
